# Copy this file to .env.local and fill in real values from the Supabase
# project's Settings -> API page. Never commit the real .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key -- needed by the /api/cron/* routes and any server-side
# route that must bypass RLS after verifying the caller by hand (see
# src/lib/serverAuth.ts). Keep this out of the client bundle: only read it
# in server-only files (route handlers), never in a 'use client' component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set this and Vercel Cron will send it as a Bearer token on
# scheduled requests, so /api/cron/* can reject anyone else hitting them.
CRON_SECRET=
